 {
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    
    "esModuleInterop": true,
    "outDir": "dist",
   
    "moduleResolution": "Bundler",
    "declaration": true,
    "baseUrl": ".", 
    "types": [
      "node",
      "chai",
      "mocha",
      "hardhat/config"
    ],
    "skipLibCheck": true
  },

  "include": [
    "hardhat.config.ts",
    "scripts",
    "tasks",
    "plugins",
    "scenario",
    "test",
    "types/**/*.d.ts"
  ]
}
