{
  "name": "comet",
  "version": "0.1.0",
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "files": [
    "dist",
    "deployments/**/roots.json"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./deployments/*": "./deployments/*"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "*": [
        "dist/*"
      ],
      "deployments/*": [
        "deployments/*"
      ]
    }
  },
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean && rm -rf build/ cache/ coverage* dist/",
    "cover": "hardhat coverage && npx istanbul report --include coverage.json html lcov",
    "gas": "REPORT_GAS=true yarn test",
    "lint": "eslint 'plugins/**/*' 'scenario/**/*' 'scripts/**/*' 'src/**/*' 'tasks/**/*' 'test/**/*' hardhat.config.ts",
    "lint-contracts": "solhint 'contracts/**/*.sol'",
    "lint-contracts:fix": "solhint --fix 'contracts/**/*.sol'",
    "scenario": "hardhat scenario",
    "spider": "hardhat spider",
    "test": "hardhat test ./test/*.ts ./test/**/*.ts ./plugins/deployment_manager/test/*.ts ",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192' hardhat coverage --no-compile",
    "audit:liquidator": "vendoza contracts/liquidator/vendor/manifest.json",
    "audit:vendor": "vendoza contracts/vendor/manifest.json",
    "slither:fn-clashes": "slither-check-upgradeability contracts/Configurator.sol Configurator --proxy-filename contracts/ConfiguratorProxy.sol --proxy-name ConfiguratorProxy",
    "liquidation-bot": "hardhat run scripts/liquidation_bot/index.ts"
  },
  "keywords": [],
  "author": "Compound Finance",
  "license": "UNLICENSED",
  "dependencies": {
    "@flashbots/ethers-provider-bundle": "^0.5.0",
    "@openzeppelin/contracts": "4.8.3",
    "@tenderly/api-client": "^1.1.0",
    "@tenderly/sdk": "^0.3.1",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "deep-object-diff": "^1.1.9",
    "jest-diff": "^27.4.2",
    "undici": "^5.21.2"
  },
  "devDependencies": {
    "@arbitrum/sdk": "^3.1.2",
    "@ethersproject/experimental": "^5.7.0",
    "@nomicfoundation/ethereumjs-rlp": "^5.0.4",
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@nomicfoundation/hardhat-verify": "3.0.22",
    "@safe-global/safe-core-sdk": "^3.3.2",
    "@safe-global/safe-ethers-lib": "^1.9.2",
    "@typechain/ethers-v6": "0.5.1",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "^5.18.0",
    "@typescript-eslint/parser": "^5.18.0",
    "chalk": "^5.0.0",
    "dotenv": "^10.0.0",
    "eslint": "^8.12.0",
    "ethers": "6.17.0",
    "fast-glob": "^3.2.7",
    "hardhat": "3.12.0",
    "mocha": "^11.7.4",
    "mocha-junit-reporter": "^2.0.2",
    "mocha-multi-reporters": "hayesgm/mocha-multi-reporters#hayesgm/reporter-options-to-option",
    "nock": "^13.2.2",
    "sc-istanbul": "^0.4.5",
    "solhint": "^3.3.6",
    "ts-node": "^10.4.0",
    "typechain": "8.3.2",
    "typescript": "5.9.3",
    "vendoza": "0.0.4"
  },
  "repository": "git@github.com:compound-finance/comet.git",
  "resolutions": {
    "minimatch": "^3.1.2",
    "cbor": "8.1.0",
    "micro-eth-signer": "0.14.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
