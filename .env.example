# =============================================================================
# COMET — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Most variables are optional — see the sections below for details.
#
# Required for compilation (yarn build):       NONE
# Required for Comet unit tests (yarn test):   NONE
# =============================================================================


# =============================================================================
# RPC ENDPOINTS (QuickNode)
# Required when: deploying to, forking, or running scenarios against a network.
# All of these are also passed as GitHub Actions secrets so that CI workflows
# (run-unit-tests, run-scenarios, deploy-market, etc.) can fork the right chain.
#
# MAINNET_QUICKNODE_LINK is additionally required for:
#   - Liquidation Bot & Liquidator tests
#   - Foundry forge tests (declared in foundry.toml [rpc_endpoints])
# =============================================================================

MAINNET_QUICKNODE_LINK=         # Ethereum mainnet — REQUIRED for Liquidation Bot & Liquidator tests; used by foundry.toml
SEPOLIA_QUICKNODE_LINK=         # Ethereum Sepolia testnet; used by foundry.toml (via SEPOLIA_RPC_URL alias — see below)
POLYGON_QUICKNODE_LINK=         # Polygon (MATIC) mainnet; used by foundry.toml
OPTIMISM_QUICKNODE_LINK=        # Optimism mainnet; used by foundry.toml
BASE_QUICKNODE_LINK=            # Base mainnet; used by foundry.toml
ARBITRUM_QUICKNODE_LINK=        # Arbitrum One mainnet; used by foundry.toml
MANTLE_QUICKNODE_LINK=          # Mantle mainnet; used by foundry.toml
LINEA_QUICKNODE_LINK=           # Linea mainnet
UNICHAIN_QUICKNODE_LINK=        # Unichain mainnet
UNICHAIN_QUICKNODE_KEY=         # Unichain QuickNode API key (used separately in forge test workflow)
RONIN_QUICKNODE_LINK=           # Ronin mainnet


# =============================================================================
# FOUNDRY-SPECIFIC RPC ENDPOINTS
# foundry.toml [rpc_endpoints] maps network names to these variables.
# Scroll and Sepolia use their own dedicated vars (not the QuickNode links above).
# Networks covered by foundry.toml: mainnet, polygon, arbitrum, optimism,
#   scroll, base, sepolia, mantle.
# Linea, Unichain, and Ronin are NOT in foundry.toml.
# =============================================================================

SCROLL_RPC_URL=                 # Scroll mainnet RPC URL — used exclusively by foundry.toml
SEPOLIA_RPC_URL=                # Sepolia RPC URL — used exclusively by foundry.toml (separate from SEPOLIA_QUICKNODE_LINK)


# =============================================================================
# ALTERNATIVE RPC PROVIDERS
# INFURA_KEY is passed to every GitHub Actions workflow as a fallback RPC
# provider. This is important when the repo is forked: forked PRs do not
# receive repository secrets (QuickNode links), so CI falls back to Infura
# to still be able to fork networks for tests.
# INFURA_KEY is also used directly by forge tests (OnChainLiquidator,
# PolygonLiquidator in forge/test/).
# ANKR_KEY is used by the CAPO subproject (contracts/capo).
# =============================================================================

INFURA_KEY=                     # Infura project key — CI fallback RPC for forked PRs; also used by forge/test liquidator tests
ANKR_KEY=                       # Ankr RPC key; used by CAPO subproject (contracts/capo)


# =============================================================================
# BLOCK EXPLORER API KEYS
# Required when: running `spider`, verifying contracts after deployment,
# or running GitHub Actions workflows that include verification steps.
# Not needed for compilation or unit tests.
#
# Two naming conventions exist in this repo:
#   ETHERSCAN_KEY_FOR_*  — used by the Hardhat Etherscan plugin (hardhat.config.ts)
#   *SCAN_KEY            — used by GitHub Actions workflows and direct API calls
# Both may be needed for the same network.
# =============================================================================

ETHERSCAN_KEY=                  # Ethereum mainnet, Sepolia, Mantle, Scroll — Hardhat plugin verification & spider
ETHERSCAN_KEY_FOR_POLYGON=      # Polygonscan — Hardhat plugin
ETHERSCAN_KEY_FOR_ARBITRUM=     # Arbiscan — Hardhat plugin
ETHERSCAN_KEY_FOR_BASE=         # Basescan — Hardhat plugin
ETHERSCAN_KEY_FOR_OPTIMISM=     # Optimistic Etherscan — Hardhat plugin
ETHERSCAN_KEY_FOR_LINEA=        # Lineascan — Hardhat plugin
SNOWTRACE_KEY=                  # Snowtrace (Avalanche / Fuji testnet) — Hardhat plugin & spider

POLYGONSCAN_KEY=                # Polygonscan — GitHub Actions workflows and direct API calls
OPTIMISMSCAN_KEY=               # Optimistic Etherscan — GitHub Actions workflows
BASESCAN_KEY=                   # Basescan — GitHub Actions workflows
MANTLESCAN_KEY=                 # Mantlescan — GitHub Actions workflows
SCROLLSCAN_KEY=                 # Scrollscan — GitHub Actions workflows


# =============================================================================
# TENDERLY (optional)
# TENDERLY_USERNAME and TENDERLY_ACCESS_KEY are used for contract simulation
# and verification in governance migration workflows (enact-migration).
# The gateway keys (_TENDERLY_KEY_*) are network-specific RPC gateway keys
# used to route transactions through Tenderly for Ronin and Polygon.
# =============================================================================

TENDERLY_USERNAME=              # Tenderly account username
TENDERLY_ACCESS_KEY=            # Tenderly API access key
_TENDERLY_KEY_RONIN=            # Tenderly gateway key for Ronin network RPC
_TENDERLY_KEY_POLYGON=          # Tenderly gateway key for Polygon network RPC


# =============================================================================
# ACCOUNT / SIGNING
# Required when: deploying contracts or sending real transactions.
# Not needed for local tests or compilation.
# =============================================================================

ETH_PK=                         # Raw private key — takes precedence over MNEMONIC
MNEMONIC=                       # BIP39 mnemonic for HD wallet account derivation
REMOTE_ACCOUNTS=                # Set to 'true' to use Hardhat remote account signing


# =============================================================================
# GAS REPORTING (optional)
# Required when: running `yarn gas` or wanting USD cost estimates.
# =============================================================================

REPORT_GAS=                     # Set to 'true' to enable gas usage reporting
COINMARKETCAP_API_KEY=          # CoinMarketCap key for USD gas cost conversion (optional within gas reports)


# =============================================================================
# NETWORK / DEPLOYMENT OVERRIDES (optional)
# Used by deployment scripts and governance workflows.
# =============================================================================

NETWORK_PROVIDER=               # Override the default RPC URL for the target network
GOV_NETWORK=                    # Governance network name (e.g. 'mainnet', 'sepolia')
GOV_NETWORK_PROVIDER=           # Override RPC URL for the governance network


# =============================================================================
# GOVERNANCE / MIGRATION WORKFLOWS
# Required when: running deploy-market, prepare-migration, or enact-migration
# GitHub Actions workflows. WALLET_CONNECT_PROJECT_ID is used by the Gnosis
# Safe UI embedded in those workflows for multisig proposal creation.
# =============================================================================

WALLET_CONNECT_PROJECT_ID=      # WalletConnect project ID for Gnosis Safe multisig proposals in governance workflows


# =============================================================================
# LIQUIDATION BOT
# Required when: running the on-chain liquidation bot (scripts/liquidation_bot).
# =============================================================================

LIQUIDATOR_ADDRESS=             # Address of the deployed Liquidator contract
USE_FLASHBOTS=                  # Set to 'true' to route liquidation txs through Flashbots (hides them from the public mempool)


# =============================================================================
# ADVANCED / RARELY NEEDED
# =============================================================================

OPTIMIZER_DISABLED=             # Set to 'true' to disable the Solidity optimizer (affects viaIR builds)
LOGGING=                        # Set to 'true' to enable verbose Hardhat logging during tests
SALT=                           # CREATE2 deployment salt (default: 'comet'); override for deterministic addresses
