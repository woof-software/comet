# ==========================================================================
# Comet — environment variables
#
# Copy this file to `.env` and fill in the values you need.
# Variables in the "Required" section must be set for the project to run;
# everything else is only needed for specific chains or tasks.
# ==========================================================================

# --------------------------------------------------------------------------
# Required
# --------------------------------------------------------------------------
# Etherscan (V2) API key — used for contract verification and by the `spider`
# task to pull verified ABIs. Also reused for Mantle, Unichain and Scroll.
ETHERSCAN_KEY=''

# RPC endpoints (e.g. QuickNode HTTP URLs) for the always-loaded networks.
MAINNET_QUICKNODE_LINK=''
UNICHAIN_QUICKNODE_LINK=''
LINEA_QUICKNODE_LINK=''

# --------------------------------------------------------------------------
# Per-chain RPC endpoints (set only for the chains you work with)
# --------------------------------------------------------------------------
RONIN_QUICKNODE_LINK=''
POLYGON_QUICKNODE_LINK=''
OPTIMISM_QUICKNODE_LINK=''
MANTLE_QUICKNODE_LINK=''
BASE_QUICKNODE_LINK=''
ARBITRUM_QUICKNODE_LINK=''
# Note: Scroll uses a public gateway and needs no RPC variable.

# --------------------------------------------------------------------------
# Per-chain block explorer API keys (for contract verification)
# --------------------------------------------------------------------------
ETHERSCAN_KEY_FOR_OPTIMISM=''
ETHERSCAN_KEY_FOR_BASE=''
ETHERSCAN_KEY_FOR_ARBITRUM=''
ETHERSCAN_KEY_FOR_POLYGON=''
ETHERSCAN_KEY_FOR_LINEA=''

# --------------------------------------------------------------------------
# Tenderly (only for `migrate --tenderly` / `migrate --tenderlyVnet`)
# See MIGRATIONS.md > Simulating the governance proposal.
# --------------------------------------------------------------------------
TENDERLY_USERNAME=''
TENDERLY_ACCESS_KEY=''
# Escape hatch for accounts that can't create Virtual TestNets via the API:
# paste the Admin RPC URL of one created from the Tenderly dashboard and it is
# reused instead. The _<NETWORK> form wins for that network.
# TENDERLY_VNET_RPC_URL=
# TENDERLY_VNET_RPC_URL_BASE=

# --------------------------------------------------------------------------
# Deployer account (used when broadcasting transactions)
# Provide ETH_PK or MNEMONIC; ETH_PK takes precedence.
# --------------------------------------------------------------------------
ETH_PK=''
# Leave MNEMONIC commented out to fall back to the repo's default test mnemonic.
# Setting it to an empty string overrides that default and breaks account
# derivation, including on the local hardhat network.
# MNEMONIC=

# --------------------------------------------------------------------------
# Gas reporting (optional)
# Set REPORT_GAS=true to print a gas report after `yarn test`.
# COINMARKETCAP_API_KEY additionally shows costs in USD.
# --------------------------------------------------------------------------
REPORT_GAS=false
COINMARKETCAP_API_KEY=''

# --------------------------------------------------------------------------
# Advanced RPC / account overrides (optional)
# --------------------------------------------------------------------------
# Override the RPC URL for every network.
NETWORK_PROVIDER=''
# Override the RPC URL for only the governance network: set GOV_NETWORK to the
# network name and GOV_NETWORK_PROVIDER to its RPC URL.
GOV_NETWORK=''
GOV_NETWORK_PROVIDER=''
# Use the node's own unlocked ("remote") accounts instead of ETH_PK/MNEMONIC.
REMOTE_ACCOUNTS=''

